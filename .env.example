# ---------------------------------------------------------------------------
# RoHair — variáveis de ambiente
#
# Copie para `.env.local` e preencha. O schema em src/core/env/env.ts é a fonte
# de verdade: variável inválida derruba a aplicação no boot, de propósito.
#
# As seções marcadas com a fase ainda não têm serviço provisionado. Só passam a
# ser obrigatórias quando a fase correspondente começar.
# ---------------------------------------------------------------------------

# Ambiente lógico: local | preview | staging | production
APP_ENV=local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Fase 3 · Banco de dados (Railway) ---
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco?sslmode=require

# --- Fase 4 · Identidade e sessão ---
# REDIS_URL=redis://host:porta
# Chave HMAC da busca por CPF — gere com: openssl rand -hex 32
# CPF_HASH_SECRET=
# Chave AES-256-GCM do CPF (64 caracteres hexadecimais) — openssl rand -hex 32
# CPF_ENCRYPTION_KEY=

# --- Fase 6 · Fotos antes e depois (Cloudflare R2) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=rohair-media
